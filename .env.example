# --- Database ---
# Used both by docker-compose (to provision the postgres container) and by
# the app (to connect). Inside Docker, the app reaches Postgres at db:5432.
# From the host machine (e.g. running scripts via the local .venv, not
# Docker), use localhost:5435 instead — see docker-compose.yml's port
# mapping note (5432 is already taken by a native Postgres on this machine).
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecommerce
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ecommerce:change_me@db:5432/ecommerce

# --- OpenRouter (LLM reports + RAG generation) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model id works; a ":free" open-weight model is recommended for this assessment.
# nvidia/nemotron-3-super-120b-a12b:free chosen 2026-09-13 (verified live against
# openrouter.ai, not from training-data memory - see INTERVIEW_PREP.md): 120B/12B-active
# MoE, 262K context, $0, explicitly accepts response_format (relevant since T117's
# narrative parsing relies on JSON-then-Pydantic-validate). Used for both the T116-126
# business reports and the upcoming Phase 8 RAG generation - one model, one thing to
# explain, rather than two configs. Deliberately NOT thinkingmachines/inkling-small:free,
# despite being tagged "good for RAG applications" - its free tier is restricted to
# agentic coding harnesses (Claude Code/Codex-style tool use), not a backend service
# calling it programmatically, and OpenRouter's own docs say prompts/outputs on that free
# tier are logged to improve Thinking Machines' models. Previous default
# (qwen/qwen-2.5-72b-instruct:free) is still live and works fine as a fallback if this
# one is ever deprecated/rate-limited - the free-model roster turns over fairly often.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Embeddings (RAG) ---
# Embeddings (rag/embeddings.py) are generated by an Ollama server via its
# /api/embed endpoint - point OLLAMA_BASE_URL at any Ollama instance that has
# EMBEDDING_MODEL pulled (`ollama pull qwen3-embedding:0.6b`). Decision log
# (2026-09-13, INTERVIEW_PREP.md): OpenRouter also offers free embedding models,
# but its free tier is capped at 50 requests/day *shared* with the generation
# calls above - too tight for ingest + live querying; a locally downloaded
# sentence-transformers model was the original plan but needs a ~1.2GB download
# on every machine that runs this. The Ollama route needs neither. To reproduce
# on another machine: run Ollama locally (http://localhost:11434) and pull the
# same model tag.
# Model: Qwen3-Embedding-0.6B (Ollama tag below == Hugging Face
# Qwen/Qwen3-Embedding-0.6B weights), 1024-dim, 32K-token context. Larger
# Qwen3-Embedding sizes (4B = 2560-dim, 8B = 4096-dim) were rejected because
# pgvector's HNSW index has a hard 2000-dimension cap (verified live on
# pgvector 0.8.6) - the rag_chunks index would fail to build.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# --- RAG retrieval (rag/retrieve.py) ---
# Hallucination guard: if the best-matching chunk's cosine similarity is below
# this, the assistant answers "insufficient data" instead of guessing. Not a
# guess - `python -m rag.calibrate` embeds a probe set and prints the gap
# (2026-09-13: in-domain best hits 0.565-0.844, off-topic 0.102-0.240, so the
# midpoint 0.40 leaves ~0.16 of margin on each side). Re-run calibrate after
# editing rag/documents or changing EMBEDDING_MODEL - either moves the numbers.
RAG_SIMILARITY_THRESHOLD=0.40
# Chunks handed to the LLM per question (each is one `##` section, ~40-400 words).
RAG_TOP_K=4

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
