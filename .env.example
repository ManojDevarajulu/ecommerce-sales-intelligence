# --- Database ---
# Used both by docker-compose (to provision the postgres container) and by
# the app (to connect). Inside Docker, the app reaches Postgres at db:5432.
# From the host machine (e.g. running scripts via the local .venv, not
# Docker), use localhost:5435 instead — see docker-compose.yml's port
# mapping note (5432 is already taken by a native Postgres on this machine).
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ecommerce
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ecommerce:change_me@db:5432/ecommerce

# --- OpenRouter (LLM reports + RAG generation) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model id works; a ":free" open-weight model is recommended for this assessment.
# nvidia/nemotron-3-super-120b-a12b:free chosen 2026-09-13 (verified live against
# openrouter.ai, not from training-data memory - see INTERVIEW_PREP.md): 120B/12B-active
# MoE, 262K context, $0, explicitly accepts response_format (relevant since T117's
# narrative parsing relies on JSON-then-Pydantic-validate). Used for both the T116-126
# business reports and the upcoming Phase 8 RAG generation - one model, one thing to
# explain, rather than two configs. Deliberately NOT thinkingmachines/inkling-small:free,
# despite being tagged "good for RAG applications" - its free tier is restricted to
# agentic coding harnesses (Claude Code/Codex-style tool use), not a backend service
# calling it programmatically, and OpenRouter's own docs say prompts/outputs on that free
# tier are logged to improve Thinking Machines' models. Previous default
# (qwen/qwen-2.5-72b-instruct:free) is still live and works fine as a fallback if this
# one is ever deprecated/rate-limited - the free-model roster turns over fairly often.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Embeddings (RAG) ---
# Local sentence-transformers model, no external API needed for embeddings (SCOPE.md's
# Task 8 locked decision - avoids per-chunk API cost/latency/quota during ingest).
# Qwen/Qwen3-Embedding-0.6B chosen 2026-09-13 (verified live, not memory): best
# quality-per-size open embedding model as of now (70.7 MTEB-eng-v2, ~1.2GB, ~6s load) -
# a real step up from the older all-MiniLM-L6-v2 default below. Needs
# sentence-transformers>=2.7.0 + transformers>=4.51.0; confirmed the project's actual
# venv already has sentence-transformers 3.1.1 / transformers 4.57.6, both well past
# that floor - no requirements.txt change needed. EMBEDDING_DIM=1024 is this model's
# default output size (used for Phase 8's pgvector column dimension, not yet built).
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
# Previous default, still a safe fallback if the above is ever unavailable:
#   EMBEDDING_MODEL=all-MiniLM-L6-v2
#   EMBEDDING_DIM=384

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
