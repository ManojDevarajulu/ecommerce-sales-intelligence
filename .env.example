# --- Database ---
# Used by docker-compose and the FastAPI application.
# Container-to-container connection uses host 'db' on port 5432.
# Host-to-container connection (for local scripts/tests) uses port 5435.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=password
POSTGRES_DB=db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=url

# --- OpenRouter (AI Reports + RAG Generation) ---
# Authentication key available at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model for executive reporting and RAG synthesis
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Embeddings (RAG) ---
# Ollama embedding server endpoint and model tag
OLLAMA_BASE_URL=base_url
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# --- RAG Retrieval Settings ---
# Calibrated cosine similarity cutoff for hallucination guardrail
RAG_SIMILARITY_THRESHOLD=0.40
# Number of context chunks retrieved per query
RAG_TOP_K=4

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO

